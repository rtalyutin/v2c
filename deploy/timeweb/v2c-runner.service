[Unit]
Description=v2c disposable VM runner
After=network-online.target docker.service v2c-runner-firewall.service
Requires=docker.service v2c-runner-firewall.service
RequiresMountsFor=/var/lib/v2c-runner
ConditionPathExists=/etc/v2c-runner/bootstrap-ready

[Service]
Type=simple
User=root
Group=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DOCKER_CONFIG=/etc/v2c-runner/docker-client
ExecStart=/opt/v2c/venv/bin/python -m v2c.runner_service --config /etc/v2c-runner/runner.json --tls-cert /etc/v2c-runner/server.crt --tls-key /etc/v2c-runner/server.key --client-ca /etc/v2c-runner/client-ca.crt --port __RUNNER_PORT__
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/v2c-runner /run/docker.sock
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
