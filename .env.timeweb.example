# Copy to .env.timeweb and combine explicitly:
# docker compose --env-file .env --env-file .env.timeweb --profile timeweb-gateway up -d
# Timeweb cloud credentials belong in
# /etc/v2c-operator/gateway/gateway.json, mounted only by the gateway service.
# Keep V2C_VM_PROVIDER_TOKEN in the control .env; it is the gateway bearer token,
# not the Timeweb cloud API token. See docs/timeweb.md for the private layout.
V2C_TIMEWEB_CONFIG_DIR=/etc/v2c-operator/gateway
V2C_TIMEWEB_GATEWAY_BIND_ADDRESS=127.0.0.1
V2C_TIMEWEB_GATEWAY_PORT=9443
V2C_VM_PROVIDER_URL=https://timeweb-gateway:9443
V2C_RUNNER_SERVER_NAME=runner.v2c.internal
# The agreed first free smoke/small-change model; no paid/provider fallback.
# Set GROQ_API_KEY only in control .env; no duplicate assignment here, so this
# override file cannot shadow a configured key with an empty value.
# The key stays on the trusted control API/worker and is not sent to gateway/VM.
# Without it, model_probe returns NEEDS_KEY before any network request.
V2C_MODEL_PRESET=groq-free-gpt-oss-120b
# Cold bootstrap may install packages and pull pinned images. This is an
# operator-adjustable deployment deadline, not a performance guarantee.
V2C_PROVISION_TIMEOUT_SECONDS=1800
V2C_PROVISION_POLL_SECONDS=5
# The generic 3600-second run deadline still applies and caps each provision by
# its remaining time. Raising that total limit is a separate operator decision.
