# Copy to .env; fill real values locally. This example contains no active keys.
V2C_API_TOKEN=
V2C_DATABASE_URL=postgresql+psycopg://v2c:CHANGE_ME@postgres:5432/v2c
V2C_POSTGRES_PASSWORD=
V2C_STORAGE_BACKEND=s3
V2C_S3_ENDPOINT_URL=
V2C_S3_BUCKET=v2c
V2C_S3_PREFIX=v2c
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
V2C_WORK_ROOT=/data/work
V2C_ARTIFACT_ROOT=/data/artifacts
# Comma-separated explicitly allowed Git hosts; empty disables remote import.
V2C_GIT_ALLOWED_HOSTS=
# No model is selected by default. Explicit optional free smoke/small-change
# profile: V2C_MODEL_PRESET=groq-free-gpt-oss-120b, key only in GROQ_API_KEY.
# This preset has 6000 input bytes / 1024 output tokens and no provider fallback.
# It does not establish billing eligibility or qualify large-project conversion.
V2C_MODEL_PRESET=
GROQ_API_KEY=
# Custom OpenAI-compatible profile; leave blank when selecting the preset.
# Base URL normally ends with /v1.
V2C_MODEL_BASE_URL=
V2C_MODEL=
V2C_MODEL_API_KEY=
# Custom-profile defaults; explicit preset overrides above its ceilings fail.
# V2C_MODEL_API_KEY_ENV=V2C_MODEL_API_KEY
# V2C_MODEL_PROFILE_VERSION=1
# V2C_MAX_OUTPUT_TOKENS=8192
# V2C_MODEL_MAX_INPUT_BYTES=262144
# V2C_MAX_RESPONSE_BYTES=1048576
# V2C_MODEL_TIMEOUT_SECONDS=90
# REST VM lifecycle bridge and mTLS runner endpoints. See docs/runner-protocol.md.
V2C_VM_PROVIDER_URL=
V2C_VM_PROVIDER_TOKEN=
V2C_RUNNER_BASE_URL=
# Fixed operator DNS SAN; TLS connects to the allocated IP with this SNI/Host.
V2C_RUNNER_SERVER_NAME=
V2C_RUNNER_TOKEN=
V2C_RUNNER_CA_CERT=/run/v2c-certs/ca.crt
V2C_RUNNER_CLIENT_CERT=/run/v2c-certs/client.crt
V2C_RUNNER_CLIENT_KEY=/run/v2c-certs/client.key
V2C_CERTS_DIR=./certs
V2C_RUNNER_IMAGE=
V2C_RUNNER_CPUS=1
V2C_RUNNER_MEMORY_MB=1024
V2C_RUNNER_PIDS=128
V2C_RUNNER_DISK_MB=512
V2C_RUNNER_MAX_OUTPUT_BYTES=65536
V2C_LEASE_SECONDS=60
V2C_COMMAND_TIMEOUT_SECONDS=120
# VM cold boot and deletion use a separate deadline/poll, not a project command limit.
V2C_PROVISION_TIMEOUT_SECONDS=600
V2C_PROVISION_POLL_SECONDS=5
V2C_RUN_TIMEOUT_SECONDS=3600
V2C_MAX_UPLOAD_BYTES=67108864
V2C_BIND_ADDRESS=127.0.0.1
# Optional local S3 emulator profile only; use an operator-reviewed pinned image.
V2C_MINIO_IMAGE=v2c-minio:operator-built
V2C_MINIO_ROOT_USER=
V2C_MINIO_ROOT_PASSWORD=
